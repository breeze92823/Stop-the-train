# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Local dev against the backend (`npm start` in Stop-the-train-backend): its ws:// URL. Leave unset in
# deployed builds: they reach the backend through the Bloxity matchmaker.
VITE_SERVER_URL=
# The game id registered on bloxity.io (lowercase). Defaults to the placeholder in src/config.js.
VITE_GAME_SLUG=
